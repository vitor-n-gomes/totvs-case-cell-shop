{
  "openapi": "3.0.0",
  "paths": {
    "/demo/messages": {
      "post": {
        "operationId": "DemoController_create",
        "parameters": [
          {
            "name": "x-correlation-id",
            "in": "header",
            "description": "UUID; generated when absent or invalid",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishMessageDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Kafka acknowledged publication; receipt processing is asynchronous",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedMessageDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "tags": ["Demo"]
      }
    },
    "/demo/messages/{eventId}": {
      "get": {
        "operationId": "DemoController_find",
        "parameters": [
          {
            "name": "x-correlation-id",
            "in": "header",
            "description": "UUID; generated when absent or invalid",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "eventId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageReceiptDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "No receipt yet; retry after asynchronous consumption",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "tags": ["Demo"]
      }
    }
  },
  "info": {
    "title": "CaseCellShop foundation",
    "description": "Infrastructure demonstration. Checkout and inventory are not implemented.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["statusCode", "error", "message", "correlationId"]
      },
      "PublishMessageDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "hello",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          }
        },
        "required": ["message"]
      },
      "PublishedMessageDto": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["published"]
          }
        },
        "required": ["eventId", "status"]
      },
      "MessageReceiptDto": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "enum": [1]
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "message": {
            "type": "string",
            "maxLength": 500
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "schemaVersion",
          "eventId",
          "correlationId",
          "message",
          "occurredAt",
          "receivedAt"
        ]
      }
    }
  }
}
