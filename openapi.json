{
  "openapi": "3.0.0",
  "paths": {
    "/products": {
      "get": {
        "operationId": "ShopController_getProducts",
        "parameters": [
          {
            "name": "x-correlation-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductDto"
                  }
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "",
        "tags": ["storefront"]
      }
    },
    "/checkout": {
      "post": {
        "operationId": "ShopController_create",
        "parameters": [
          {
            "name": "x-correlation-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutAcceptedDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "",
        "tags": ["storefront"]
      }
    },
    "/orders/{orderId}/status": {
      "get": {
        "operationId": "ShopController_status",
        "parameters": [
          {
            "name": "x-correlation-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "orderId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderStatusDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "",
        "tags": ["storefront"]
      }
    }
  },
  "info": {
    "title": "CaseCellShop",
    "description": "Cached catalog, idempotent checkout and asynchronous order activation.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["statusCode", "error", "message", "correlationId"]
      },
      "ProductDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "productKey": {
            "type": "string"
          },
          "netPrice": {
            "type": "string",
            "example": "29.90",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "listPrice": {
            "type": "string",
            "example": "39.90",
            "pattern": "^\\d+\\.\\d{2}$"
          }
        },
        "required": ["id", "name", "productKey", "netPrice", "listPrice"]
      },
      "CheckoutItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "required": ["productId", "quantity"]
      },
      "CheckoutDto": {
        "type": "object",
        "properties": {
          "paymentType": {
            "type": "string",
            "enum": ["PrePaid", "PostPaid"]
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "example": "2026-11-10"
          },
          "mainContact": {
            "type": "string",
            "maxLength": 254
          },
          "altContact": {
            "type": "string",
            "maxLength": 254
          },
          "paymentMethod": {
            "type": "string",
            "maxLength": 100
          },
          "environment": {
            "type": "string",
            "enum": ["Local", "PreProd", "Prod"]
          },
          "items": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CheckoutItemDto"
            }
          }
        },
        "required": [
          "paymentType",
          "dueDate",
          "mainContact",
          "paymentMethod",
          "environment",
          "items"
        ]
      },
      "CheckoutAcceptedDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["Pending"]
          }
        },
        "required": ["orderId", "status"]
      },
      "OrderItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000000
          },
          "netPrice": {
            "type": "number",
            "example": 2990
          },
          "listPrice": {
            "type": "number",
            "example": 3990
          }
        },
        "required": ["productId", "quantity", "netPrice", "listPrice"]
      },
      "OrderStatusDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["Pending", "Active", "Cancelled"]
          },
          "processingStatus": {
            "type": "string",
            "enum": ["Pending", "Processing", "Retrying", "Completed", "Failed"]
          },
          "paymentType": {
            "type": "string",
            "enum": ["PrePaid", "PostPaid"]
          },
          "paymentMethod": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "environment": {
            "type": "string",
            "enum": ["Local", "PreProd", "Prod"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemDto"
            }
          }
        },
        "required": [
          "orderId",
          "status",
          "processingStatus",
          "paymentType",
          "paymentMethod",
          "dueDate",
          "environment",
          "createdAt",
          "items"
        ]
      }
    }
  }
}
