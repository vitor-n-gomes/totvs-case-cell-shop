{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/http",
  "sourceRoot": "apps/http/src",
  "compilerOptions": {
    "webpack": true,
    "webpackConfigPath": "webpack.config.cjs",
    "tsConfigPath": "apps/http/tsconfig.app.json"
  },
  "projects": {
    "products": {
      "type": "library",
      "root": "libs/products",
      "entryFile": "index",
      "sourceRoot": "libs/products/src",
      "compilerOptions": {
        "tsConfigPath": "libs/products/tsconfig.lib.json"
      }
    },
    "platform": {
      "type": "library",
      "root": "libs/platform",
      "entryFile": "index",
      "sourceRoot": "libs/platform/src",
      "compilerOptions": {
        "tsConfigPath": "libs/platform/tsconfig.lib.json"
      }
    },
    "order": {
      "type": "library",
      "root": "libs/order",
      "entryFile": "index",
      "sourceRoot": "libs/order/src",
      "compilerOptions": {
        "tsConfigPath": "libs/order/tsconfig.lib.json"
      }
    },
    "http": {
      "type": "application",
      "root": "apps/http",
      "entryFile": "main",
      "sourceRoot": "apps/http/src",
      "compilerOptions": {
        "tsConfigPath": "apps/http/tsconfig.app.json"
      }
    },
    "consumer": {
      "type": "application",
      "root": "apps/consumer",
      "entryFile": "main",
      "sourceRoot": "apps/consumer",
      "compilerOptions": {
        "tsConfigPath": "apps/consumer/tsconfig.app.json"
      }
    },
    "scheduler": {
      "type": "application",
      "root": "apps/scheduler",
      "entryFile": "main",
      "sourceRoot": "apps/scheduler",
      "compilerOptions": {
        "tsConfigPath": "apps/scheduler/tsconfig.app.json"
      }
    }
  }
}
