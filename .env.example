NODE_ENV=development
API_PORT=3000
WORKER_PORT=3001
DATABASE_URL=postgresql://casecellshop:casecellshop_local@localhost:5432/casecellshop
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
# Optional authentication; supply all three SASL settings together.
KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=your-username
# KAFKA_SASL_PASSWORD=your-password
KAFKA_TOPIC=casecellshop.demo.message-created.v1
KAFKA_GROUP_ID=casecellshop-demo-worker

CHECKOUT_TOPIC=order.checkout.initiated
RESERVATION_TTL_SECONDS=900
SIMULATOR_DELAY_MS=20
SIMULATOR_TIMEOUT_MS=1000
ERP_FAILURES=0
EMAIL_FAILURES=0
SIMULATOR_PERMANENT_FAILURE=none

# Optional Docker host ports; container ports remain 3000 and 3001.
API_HOST_PORT=3000
WORKER_HOST_PORT=3001
