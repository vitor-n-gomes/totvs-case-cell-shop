{
  "name": "casecellshop",
  "version": "0.1.0",
  "private": true,
  "description": "CaseCellShop cached storefront and resilient asynchronous checkout",
  "engines": {
    "node": ">=24.9 <25",
    "npm": ">=12.2.2 <13"
  },
  "scripts": {
    "build": "npm run build:http && npm run build:consumer",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --runInBand",
    "test:cov": "npm test -- --coverage",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "migration:run": "ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d libs/platform/src/database/data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d libs/platform/src/database/data-source.ts",
    "infra:up": "docker compose up -d --wait postgres redis redis-insight kafka kafka-ui",
    "infra:init": "docker compose run --rm kafka-init",
    "infra:down": "docker compose down",
    "openapi:export": "ts-node -r tsconfig-paths/register scripts/export-openapi.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/seed.ts",
    "seed:run": "npm run seed",
    "test:overselling": "npm run seed:run && ts-node -r tsconfig-paths/register scripts/test-concurrency.ts",
    "test:happy-path": "npm run seed:run && ts-node -r tsconfig-paths/register scripts/test-happy-path.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "build:http": "nest build http",
    "build:consumer": "nest build consumer",
    "start:dev": "nest start http --watch --debug",
    "consumer:debug": "nest start consumer --watch --debug",
    "start:http:prod": "node dist/apps/http/main.js",
    "start:consumer:prod": "node dist/apps/consumer/main.js",
    "typecheck:app": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/microservices": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.6.1",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "10.6.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.9",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "allowScripts": {
    "@nestjs/core": false,
    "@parcel/watcher": false,
    "@scarf/scarf": false
  },
  "overrides": {
    "glob@>=9 <14.0.2": "^14.0.4",
    "minimatch@>=7 <11.0.1": "^11.0.6"
  },
  "packageManager": "npm@12.2.2",
  "type": "commonjs"
}
