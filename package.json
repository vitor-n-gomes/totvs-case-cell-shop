{
  "name": "casecellshop",
  "version": "0.1.0",
  "private": true,
  "description": "CaseCellShop HTTP API and Kafka worker foundation",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=12.2.2 <13"
  },
  "scripts": {
    "build": "npm run build:api && npm run build:worker",
    "build:api": "nest build api",
    "build:worker": "nest build worker",
    "start:api:dev": "nest start api --watch",
    "start:worker:dev": "nest start worker --watch",
    "start:api:prod": "node dist/apps/api/main.js",
    "start:worker:prod": "node dist/apps/worker/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --selectProjects unit --runInBand",
    "test:cov": "npm test -- --coverage",
    "test:integration": "jest --selectProjects integration --runInBand",
    "migration:run": "ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d libs/platform/src/database/data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d libs/platform/src/database/data-source.ts",
    "infra:up": "docker compose up -d --wait postgres redis kafka",
    "infra:init": "docker compose run --rm kafka-init",
    "infra:down": "docker compose down",
    "openapi:export": "ts-node -r tsconfig-paths/register scripts/export-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.6.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.9",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "allowScripts": {
    "@nestjs/core": false,
    "@scarf/scarf": false
  },
  "overrides": {
    "glob@>=9 <14.0.2": "^14.0.4",
    "minimatch@>=7 <11.0.1": "^11.0.6"
  },
  "packageManager": "npm@12.2.2",
  "type": "commonjs"
}
